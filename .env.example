# Wajib di produksi. Tanpa ini situs otomatis noindex.
NEXT_PUBLIC_SITE_URL=https://sakolentra.vercel.app
# Opsional: set true di preview/staging agar tidak terindeks.
NEXT_PUBLIC_NOINDEX=false
# Opsional: token verifikasi Google Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Resend (form kontak) ---
# Buat API key di https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Alamat pengirim — harus domain terverifikasi di Resend (andypratama.studio sudah verified).
# Boleh alamat apa pun di domain itu (noreply@, halo@, dst). Penerima tidak harus domain yang sama.
RESEND_FROM_EMAIL="Sakolentra <noreply@andypratama.studio>"
# Inbox yang menerima lead dari form.
CONTACT_TO_EMAIL=andypratama1211@gmail.com

# --- Cal.com ---
# Username di https://cal.com/andypratama
NEXT_PUBLIC_CAL_USERNAME=andypratama
